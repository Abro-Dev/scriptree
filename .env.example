# Copy to .env.local and fill in from Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public address of the app (sign-in slips, password-reset links). Production: https://scriptree.dev
# Leave empty locally and the app uses whatever address it is running on.
VITE_SITE_URL=

# Only used by `npm run seed` (never shipped to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
